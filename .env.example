# Copy to .env.local. Everything is optional: with no env vars the app runs fully local
# (embedded Postgres via PGlite in .data/pglite, demo logins, mock payments, local uploads).

# --- Demo ---
# Demo logins, "Reset demo data" and the vendor auto-responder. Set to false for a real deployment.
DEMO_MODE=true
# Keep demo logins but stop vendors auto-quoting.
# DEMO_AUTO_RESPONDER=false
# Seconds before the auto-quote arrives (default 6).
# DEMO_AUTO_REPLY_DELAY=6

# --- Sessions ---
# HMAC secret for the session cookie. Required in production (openssl rand -base64 32).
# AUTH_SECRET=

# --- Database ---
# Leave unset to use embedded PGlite. Set to use Docker Postgres (docker compose up -d db),
# the Supabase CLI local stack (supabase start), or a hosted Supabase project.
# DATABASE_URL=postgres://eventually:eventually@localhost:54329/eventually
# Hosted Postgres is migrated with `pnpm db:migrate`; set this to migrate on boot instead.
# DB_AUTO_MIGRATE=true
# PGLITE_DIR=.data/pglite

# --- Supabase Auth (email magic link + Google) ---
# When both are set, sign-in uses Supabase Auth instead of the local magic link.
# Add <site>/auth/callback to the Supabase redirect URLs and enable the Google provider.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Storage ---
# With a service-role key, uploads go to Supabase Storage (public bucket below); otherwise to UPLOADS_DIR.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media
# UPLOADS_DIR=.data/uploads
